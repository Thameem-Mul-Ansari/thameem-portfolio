---
// Two crossed event tapes scrolling in opposite directions.
const build = ['AI agents', 'Voice agents', 'RAG systems', 'Workflow automation', 'RPA bots', 'Analytics dashboards', 'MCP servers'];
const tools = ['LangGraph', 'n8n', 'Azure OpenAI', 'Power Automate', 'Twilio', 'FastAPI', 'React', 'Copilot Studio', 'Supabase'];
---
<div class="tapes">
  <div class="tape tape-orange" aria-hidden="true">
    <div class="track reverse">
      <ul>{tools.map((t) => <li>{t}</li>)}</ul>
      <ul>{tools.map((t) => <li>{t}</li>)}</ul>
    </div>
  </div>
  <div class="tape tape-blue" aria-label="What I build">
    <div class="track">
      <ul>{build.map((b) => <li>{b}</li>)}</ul>
      <ul aria-hidden="true">{build.map((b) => <li>{b}</li>)}</ul>
    </div>
  </div>
</div>

<style>
  .tapes { position: relative; height: clamp(96px, 14vh, 128px); overflow: hidden; }
  .tape { position: absolute; left: -4%; width: 108%; top: 50%; overflow: hidden; padding-block: clamp(0.5rem, 1.2vh, 0.75rem); box-shadow: 0 10px 24px -14px rgba(22, 24, 29, 0.6); }
  .tape-blue { z-index: 2; background: var(--blue); color: #fff; transform: translateY(-50%) rotate(-1.6deg); }
  .tape-orange { z-index: 1; background: var(--orange); color: var(--ink); transform: translateY(-50%) rotate(1.8deg); }
  .track { display: flex; width: max-content; animation: scroll 40s linear infinite; }
  .track.reverse { animation-direction: reverse; animation-duration: 52s; }
  .tapes:hover .track { animation-play-state: paused; }
  ul { list-style: none; display: flex; margin: 0; padding: 0; }
  li { display: flex; align-items: center; white-space: nowrap; font-weight: 600; font-size: clamp(1rem, min(1.5vw, 2.6vh), 1.35rem); line-height: 1.2; }
  .tape-blue li { font-family: var(--serif); font-weight: 400; font-size: clamp(1.4rem, min(2.2vw, 3.8vh), 2rem); line-height: 1; }
  li::after { content: '✦'; margin-inline: 1.4rem; font-size: 0.7em; }
  .tape-blue li::after { color: var(--orange); font-family: var(--sans); }
  .tape-orange li::after { color: #fff; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }
</style>