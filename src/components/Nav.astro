---
import { profile } from '../data/profile';
const links = [
  { href: '/#home', label: 'Home' },
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '/#services', label: 'Services' },
  { href: '/#stack', label: 'Stack' },
  { href: '/#certifications', label: 'Certifications' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label={`${profile.siteName}, home`}>
      <img src="/logo.svg" alt="" width="32" height="32" />
      <span>{profile.siteName}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-ink resume" href="/resume.pdf" download>Resume</a>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, 0.9); backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid var(--line); }
  .nav-inner { display: flex; align-items: center; gap: 1.5rem; min-height: 72px; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--serif); font-size: 1.75rem; line-height: 1; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .brand img { width: 32px; height: 32px; }
  .brand:hover { color: var(--blue); }
  nav { margin-left: auto; }
  .nav-links { list-style: none; padding: 0; display: flex; gap: 0.25rem; }
  .nav-links a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.8rem; border-radius: 999px; color: var(--ink); text-decoration: none; font-weight: 500; }
  .nav-links a:hover { background: var(--mist); }
  .resume { min-height: 44px; padding-inline: 1.1rem; }
  @media (max-width: 1200px) { .nav-links { display: none; } }
  @media (max-width: 420px) { .brand { font-size: 1.4rem; } }
</style>
