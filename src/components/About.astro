---
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import casual from '../assets/images/casual.jpg';
import graduation from '../assets/images/graduation.jpg';

const { education } = profile;

// Split "~40%" into "~", 40, "%" so the number can count up while the symbols stay put.
const results = profile.impact.map((r) => {
  const m = r.value.match(/^(\D*)(\d+(?:\.\d+)?)(.*)$/);
  return { ...r, prefix: m?.[1] ?? '', number: m ? Number(m[2]) : null, suffix: m?.[3] ?? '' };
});
---
<section id="about" class="section about" aria-labelledby="about-title">
  <div class="container about-grid">
    <!-- Casual photo first, then fades to the graduation photo, and back. -->
    <figure class="fade-frame">
      <div class="layer one">
        <Image src={casual} alt="Thameem relaxing outdoors in Chennai" widths={[400, 700, 900]} sizes="(min-width: 900px) 440px, 90vw" />
        <figcaption>Off the clock</figcaption>
      </div>
      <div class="layer two">
        <Image src={graduation} alt="Thameem holding his degree on graduation day at Meenakshi Sundararajan Engineering College" widths={[400, 700, 900]} sizes="(min-width: 900px) 440px, 90vw" />
        <figcaption>Graduation day, MSEC</figcaption>
      </div>
    </figure>

    <div class="text">
      <h2 id="about-title" class="section-title">About me</h2>
      {profile.about.map((p) => <p>{p}</p>)}
      <p>
        <strong class="runin">Education</strong>
        {education.degree} from {education.school}, {education.period}, with a {education.grade}.
      </p>
      {profile.achievements.map((a) => (
        <p><strong class="runin">Achievements</strong> {a}</p>
      ))}

      <ul class="results" aria-label="Results from client work" data-results>
        {results.map((r, i) => (
          <li style={`--i:${i}`}>
            <strong aria-label={r.value}>
              {r.number === null ? (
                r.value
              ) : (
                <span aria-hidden="true">{r.prefix}<span data-count={r.number}>{r.number}</span>{r.suffix}</span>
              )}
            </strong>
            <span class="bar" aria-hidden="true"></span>
            <span class="label">{r.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Count the result numbers up from 0 the first time they scroll into view.
  const list = document.querySelector<HTMLElement>('[data-results]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (list && !reduceMotion && 'IntersectionObserver' in window) {
    const counters = Array.from(list.querySelectorAll<HTMLElement>('[data-count]'));
    counters.forEach((el) => (el.textContent = '0'));
    list.classList.add('ready');

    const DURATION = 1600; // ms per number
    const STAGGER = 180;   // ms between numbers
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);

    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        list.classList.add('in');
        counters.forEach((el, i) => {
          const target = Number(el.dataset.count);
          const start = performance.now() + i * STAGGER;
          const tick = (now: number) => {
            const t = Math.min(1, Math.max(0, (now - start) / DURATION));
            el.textContent = String(Math.round(target * ease(t)));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      },
      { threshold: 0.4 },
    );
    io.observe(list);
  }
</script>

<style>
  .about { background: var(--paper); }
  .about-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }

  .fade-frame { position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius-l); overflow: hidden; background: var(--mist); box-shadow: 0 40px 80px -45px rgba(22, 24, 29, 0.6); }
  .layer { position: absolute; inset: 0; }
  .layer :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .one :global(img) { object-position: center 30%; }
  .two :global(img) { object-position: center 20%; }
  .two { animation: crossfade 10s ease-in-out infinite; }
  @keyframes crossfade { 0%, 38% { opacity: 0; } 50%, 88% { opacity: 1; } 100% { opacity: 0; } }
  figcaption { position: absolute; left: 1rem; bottom: 1rem; background: #fff; color: var(--ink); font-weight: 600; font-size: 0.9rem; padding: 0.4rem 0.8rem; border-radius: 999px; }
  .two figcaption { background: var(--orange); }

  .text p { margin-top: 1.1rem; font-size: var(--step-1); line-height: 1.6; max-width: 60ch; }
  .text h2 + p { margin-top: 1.5rem; }
  .runin { color: var(--blue-ink); font-weight: 700; margin-right: 0.35rem; }

  .results { list-style: none; padding: 1.75rem 0 0; margin-top: 2rem; border-top: 1.5px solid var(--line); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .results strong { display: block; font-family: var(--serif); font-weight: 400; font-size: clamp(2.2rem, 3.4vw, 3rem); line-height: 0.95; color: var(--blue); font-variant-numeric: tabular-nums; }
  .results li:nth-child(even) strong { color: var(--orange-ink); }
  .bar { display: block; height: 3px; width: 2.5rem; margin-top: 0.6rem; border-radius: 2px; background: var(--blue); transform-origin: left; }
  .results li:nth-child(even) .bar { background: var(--orange); }
  .label { display: block; margin-top: 0.5rem; color: var(--ink-2); line-height: 1.4; font-size: 0.9rem; }

  /* Entrance: each result rises in and its bar draws, one after another */
  .results.ready li { opacity: 0; transform: translateY(14px); }
  .results.ready .bar { transform: scaleX(0); }
  .results.in li { opacity: 1; transform: none; transition: opacity .6s ease calc(var(--i) * 180ms), transform .6s cubic-bezier(.2,.8,.2,1) calc(var(--i) * 180ms); }
  .results.in .bar { transform: scaleX(1); transition: transform 1.2s cubic-bezier(.2,.8,.2,1) calc(var(--i) * 180ms + 200ms); }

  @media (max-width: 1100px) { .results { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; } .fade-frame { max-width: 440px; } }
  @media (prefers-reduced-motion: reduce) { .two { animation: none; opacity: 0; } }
</style>