---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const d = project.data;
const site = Astro.site!;
const og = await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const url = new URL(`/projects/${project.id}`, site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: d.title,
    headline: d.title,
    description: d.summary,
    url,
    image: new URL(og.src, site).href,
    dateCreated: d.year,
    genre: d.category,
    keywords: d.stack.join(', '),
    creator: { '@type': 'Person', name: profile.name, url: site.href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: new URL('/projects', site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<BaseLayout title={d.title} description={`${d.summary} Built by ${profile.name} with ${d.stack.slice(0, 4).join(', ')}.`} image={og.src} type="article" jsonLd={jsonLd}>
  <div class="container page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/projects">All projects</a>
    </nav>
    <ProjectDetail project={project} as="h1" eager />
    {next.id !== project.id && (
      <a class="next" href={`/projects/${next.id}`}>
        <span>Next project</span>
        <strong>{next.data.title}</strong>
      </a>
    )}
  </div>
</BaseLayout>

<style>
  .page { padding-block: clamp(2rem, 5vw, 4rem) var(--section); }
  .crumbs { margin-bottom: 1.5rem; }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--ink); }
  .next { display: grid; gap: 0.3rem; margin-top: clamp(3rem, 6vw, 5rem); padding-top: 2rem; border-top: 1.5px solid var(--ink); color: var(--ink); text-decoration: none; }
  .next span { color: var(--ink-2); }
  .next strong { font-family: var(--serif); font-weight: 400; font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.05; }
  .next:hover strong { color: var(--blue-ink); }
</style>

<script>
  import { initCarousels } from '../../lib/carousel';
  initCarousels();
</script>