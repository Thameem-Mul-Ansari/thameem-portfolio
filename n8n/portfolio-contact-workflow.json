      "id": "36f4cd2e-43ef-4c53-99c0-bde77045de6b",
      "name": "Contact Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "d9256f7d-6e70-491e-b1e2-e4194a88d24f"
    },
    {
      "parameters": {
        "jsCode": "// Validates and cleans the contact form submission.\nconst raw = $input.first().json.body ?? {};\nconst body = typeof raw === 'string' ? (() => { try { return JSON.parse(raw); } catch { return {}; } })() : raw;\n\nconst clean = (v, max) => String(v ?? '').replace(/[\\u0000-\\u001F\\u007F]/g, ' ').trim().slice(0, max);\nconst name = clean(body.name, 100);\nconst email = clean(body.email, 150).toLowerCase();\nconst type = clean(body.type, 40) || 'Something else';\nconst message = String(body.message ?? '').trim().slice(0, 3000);\nconst elapsedMs = Number(body.elapsedMs ?? 0);\n\nlet status = 'ok';\nlet reason = '';\nif (clean(body.website, 200)) { status = 'spam'; reason = 'honeypot'; }\nelse if (elapsedMs > 0 && elapsedMs < 3000) { status = 'spam'; reason = 'too-fast'; }\nelse if (name.length < 2) { status = 'invalid'; reason = 'Please add your name.'; }\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) { status = 'invalid'; reason = 'Please add a valid email.'; }\nelse if (message.length < 10) { status = 'invalid'; reason = 'Please write a longer message.'; }\n\nconst escape = (s) => s.replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n\nreturn [{\n  json: {\n    valid: status === 'ok',\n    status,\n    reason,\n    name,\n    email,\n    type,\n    message,\n    messageHtml: escape(message).replace(/\\n/g, '<br>'),\n    nameHtml: escape(name),\n    page: clean(body.page, 300),\n    submittedAt: clean(body.submittedAt, 40) || new Date().toISOString(),\n  },\n}];"
      },
      "id": "e19c72c1-530e-4a8c-8f55-6d9afc3182b3",
      "name": "Validate & Clean",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "1da4b161-826f-4088-9dce-830237947116",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
