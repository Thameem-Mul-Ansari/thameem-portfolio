        "message": "={{ `<div style=\"font-family:Arial,sans-serif;font-size:15px;color:#16181d\">\n<h2 style=\"margin:0 0 12px\">New ${$json.type} enquiry</h2>\n<p><b>Name:</b> ${$json.nameHtml}<br><b>Email:</b> <a href=\"mailto:${$json.email}\">${$json.email}</a><br><b>Type:</b> ${$json.type}<br><b>Sent:</b> ${$json.submittedAt}</p>\n<p style=\"padding:12px 16px;background:#f3f4f7;border-radius:8px\">${$json.messageHtml}</p>\n<p style=\"color:#4a4f5c;font-size:13px\">From ${$json.page}. Reply to this email to answer them directly.</p>\n</div>` }}",
        "options": {
